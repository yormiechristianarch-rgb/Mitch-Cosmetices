# ============================================================
# MITCH COSMETICS SHOP — Environment Configuration
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename the copy to:  .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to Git (it is already in .gitignore)
#   4. .env.example IS safe to commit — it contains no secrets
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Local XAMPP:
#   DB_HOST=localhost
#   DB_USER=root
#   DB_PASS=
# InfinityFree:
#   DB_HOST=sqlXXX.infinityfree.net
#   DB_USER=if0_XXXXXXX
#   DB_PASS=yourpassword
#   DB_NAME=if0_XXXXXXX_yourdb

DB_HOST=localhost
DB_NAME=mitch_cosmetics
DB_USER=root
DB_PASS=

# ── Google OAuth ──────────────────────────────────────────────
# Get these from https://console.cloud.google.com
# → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#
# Leave blank to disable the "Continue with Google" button.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────
# Optional: hard-code BASE_URL if auto-detection fails on your host.
# Leave blank for automatic detection (works on most hosts).

APP_BASE_URL=
